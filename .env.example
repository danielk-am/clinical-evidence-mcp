PORT=3946
HOST=0.0.0.0
DATA_DIR=/data
MCP_PUBLIC_URL=https://clinical-evidence-mcp.example.com
MCP_DOMAIN=clinical-evidence-mcp.example.com
MCP_ALLOWED_ORIGINS=https://claude.ai
REQUESTS_PER_MINUTE=60
UPSTREAM_TIMEOUT_MS=20000
# Optional. NCBI recommends identifying API clients with an email address.
NCBI_EMAIL=
# Optional. Raises the NCBI E-utilities rate allowance when configured.
NCBI_API_KEY=

# Optional private source bridge. Configure all four values together.
# Plain HTTP is accepted only for a single-label private service hostname.
SYNDICATED_SOURCE_NAME=
SYNDICATED_SOURCE_URL=
SYNDICATED_SOURCE_TOKEN=
SYNDICATED_SOURCE_ALLOWED_ACCOUNT_IDS=
SYNDICATED_SOURCE_TIMEOUT_MS=200000
